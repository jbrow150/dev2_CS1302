Test Class
java
import static org.junit.jupiter.api.Assertions.*;
import java.util.*;
import org.junit.jupiter.api.Test;

public class ComparatorTests {

    @Test
    void testAscendingComparatorSortsLowToHigh() {
        List<Task> tasks = new ArrayList<>();
        tasks.add(new Task("Task1", Priority.HIGH));
        tasks.add(new Task("Task2", Priority.LOW));
        tasks.add(new Task("Task3", Priority.MEDIUM));

        tasks.sort(new Ascending());

        assertEquals(Priority.LOW, tasks.get(0).getPriority());
        assertEquals(Priority.MEDIUM, tasks.get(1).getPriority());
        assertEquals(Priority.HIGH, tasks.get(2).getPriority());
    }

    @Test
    void testDescendingComparatorSortsHighToLow() {
        List<Task> tasks = new ArrayList<>();
        tasks.add(new Task("Task1", Priority.LOW));
        tasks.add(new Task("Task2", Priority.HIGH));
        tasks.add(new Task("Task3", Priority.MEDIUM));

        tasks.sort(new Descending());

        assertEquals(Priority.HIGH, tasks.get(0).getPriority());
        assertEquals(Priority.MEDIUM, tasks.get(1).getPriority());
        assertEquals(Priority.LOW, tasks.get(2).getPriority());
    }

    @Test
    void testAscendingComparatorEquality() {
        Task t1 = new Task("Task1", Priority.MEDIUM);
        Task t2 = new Task("Task2", Priority.MEDIUM);

        Ascending asc = new Ascending();
        assertEquals(0, asc.compare(t1, t2));
    }

    @Test
    void testDescendingComparatorEquality() {
        Task t1 = new Task("Task1", Priority.HIGH);
        Task t2 = new Task("Task2", Priority.HIGH);

        Descending desc = new Descending();
        assertEquals(0, desc.compare(t1, t2));
    }
}
